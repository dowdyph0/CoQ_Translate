      <description />
      <leveltext><p>Ves en la oscuridad.</p>
          </leveltext>
    </mutation>
    <mutation Name="Heightened Smell" DisplayName="Olfato Aumentado" BearerDescription="aquellos con olfato aumentado">
      <description><p>Posees un olfato excepcionalmente agudo.</p>
          </description>
      <leveltext><p>Detectas la presencia de criaturas dentro de una distancia típicamente hasta <stat Name="Radius" Unit="cuadrado" />, dependiendo del terreno.</p>
            <switch Name="LevelMatch">
              <case Value="true"><p>Chance to identify nearby detected creatures</p></case>
              <default><p>{{rules|Increased chance to identify nearby detected creatures}}</p></default>
            </switch>
          </leveltext>
    </mutation>
    <mutation Name="Gills" DisplayName="branchias" BearerDescription="aquellos que tienen branchias" />
    <mutation Name="Infiltrate" DisplayName="Infiltrar" BearerDescription="aquellos que infiltran">
      <description><p>Te teleportas y llevas a las criaturas contigo.</p>
          </description>
      <leveltext><p>Te teleportas a un lugar cercano y llevas consigo a todos los que estén dentro de un radio de <stat Name="TeleportRadius" />.</p>
            <statline Name="Cooldown" DisplayName="Tiempo de recarga" />
          </leveltext>
    </mutation>
    <mutation Name="Heat Absorption" DisplayName="Absorción de calor" BearerDescription="aquellos que absorben calor">
      <description><p>Regeneras absorbiendo calor.</p>
          </description>
      <leveltext><p>Inmune al daño por calor</p>

    <mutation Name="Plasma Emission" DisplayName="Emisión Plasmática" BearerDescription="aquellos que emiten plasma">
      <description><p>Liberas una explosión de <stat Name="GasName" /> a tu alrededor.</p>
          </description>
      <leveltext><p>Libera gas para <stat Name="Duration" /></p>
            <switch Name="LevelMatch">
              <case Value="raise"><p>{{rules|Increased <stat Name="LevelEffectDescription" />}}</p></case>
              <case Value="lower"><p>{{rules|Decreased <stat Name="LevelEffectDescription" />}}</p></case>
              <default />
            </switch>
            <statline Name="Cooldown" DisplayName="Tiempo de recarga" />
          </leveltext>
    </mutation>

    <mutation Name="Dark Vision" DisplayName="Visión Oscura" BearerDescription="los ciegos a la oscuridad">
      <description />
      <leveltext><p>Ves en la oscuridad.</p>
          </leveltext>
    </mutation>
    <mutation Name="Heightened Smell" DisplayName="Olfato Afilado" BearerDescription="aquellos con olfato afilado">
      <description><p>Posees un olfato excepcionalmente agudo.</p>
          </description>
      <leveltext><p>Detectas la presencia de criaturas dentro de una distancia típicamente hasta <stat Name="Radius" Unit="cuadrado" />, dependiendo del terreno.</p>
            <switch Name="LevelMatch">
              <case Value="true"><p>Chance to identify nearby detected creatures</p></case>
              <default><p>{{rules|Increased chance to identify nearby detected creatures}}</p></default>
            </switch>
          </leveltext>
    </mutation>
    <mutation Name="Gills" DisplayName="Branquias" BearerDescription="aquellos con branquias" />
    <mutation Name="Infiltrate" DisplayName="Infiltrar" BearerDescription="aquellos que infiltran">
      <description><p>Te teletransportas y llevas a las criaturas contigo.</p>
          </description>
      <leveltext><p>Te teletransportas a un lugar cercano y llevas consigo a todos los que estén dentro de un radio de <stat Name="TeleportRadius" />.</p>
            <statline Name="Cooldown" DisplayName="Enfriamiento" />
          </leveltext>
    </mutation>
    <mutation Name="Heat Absorption" DisplayName="Absorción de Calor" BearerDescription="aquellos que absorben calor">
      <description><p>Te regeneras absorbiendo calor.</p>
          </description>
      <leveltext><p>Inmune al daño por calor</p>
            <switch Name="HealFactor">
              <case Value="0" />
              <default><p>Whenever you would have taken heat damage, you heal for <stat Name="HealFactor" />% of that damage instead</p></default>
            </switch>
          </leveltext>
    </mutation>

    <mutation Name="Repelling Force" DisplayName="Fuerza Repulsiva" BearerDescription="la repulsión">
      <description><p>Invocas una fuerza repulsiva en el área circundante, lanzando a los enemigos hacia atrás.</p>
          </description>
      <leveltext><statline Name="Area" DisplayName="Área" />
            <p><switch Name="LevelMatch"><case Value="true">Las criaturas son empujadas hacia afuera del centro de la explosión.</case><default>{{reglas|Fuerza de empuje incrementada}}</default></switch></p>
            <statline Name="Cooldown" DisplayName="Enfriamiento" />

# Database (PostgreSQL)
DB_NAME=coq_translate
DB_USER=coq
DB_PASSWORD=coq
DB_HOST=db
DB_PORT=5432

# LLM
LLM_ENDPOINT=http://llama-server:8080/v1
LLM_MODEL=local-model

# Translation target
TARGET_LANGUAGE=Spanish
LANG_CODE=es_ES

# Mod identity
MOD_NAME=SpanishLanguage
MOD_DISPLAY_NAME=Español
MOD_AUTHOR=

# LLM sampling parameters
TEMPERATURE=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0
REPEAT_PENALTY=1.1
MAX_TOKENS=1024

# Retry / concurrency
REQUEST_TIMEOUT=120
REQUEST_DELAY=0.0
MAX_RETRIES=3
RETRY_DELAY=5
BATCH_SIZE=10
WORKERS=4

# Paths
STREAMING_ASSETS_DIR=/mnt/c/Program Files (x86)/Steam/steamapps/common/Caves of Qud/CoQ_Data/StreamingAssets
# EXAMPLE_LANGUAGE_DIR=   # optional override: overrides STREAMING_ASSETS_DIR/Base/ExampleLanguage
MODELS_DIR=./models
